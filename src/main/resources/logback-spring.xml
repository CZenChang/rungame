<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 沿用 Spring Boot 預設 console（保留原本 application.yaml 的 console pattern 行為） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <!-- 前端 log 專用檔案，每日滾動，保留 30 天，單檔上限 50MB -->
    <appender name="FRONTEND_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/frontend.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/frontend.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{traceId}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 非同步包一層，避免寫檔阻塞請求 -->
    <appender name="FRONTEND_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FRONTEND_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- FRONTEND logger 只進專用檔，不往 root 傳遞（additivity=false） -->
    <logger name="FRONTEND" level="INFO" additivity="false">
        <appender-ref ref="FRONTEND_ASYNC"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
